# 复制为 .env 并填入真实值：cp .env.example .env
# 生成 JWT_SECRET：python -c "import secrets; print(secrets.token_hex(32))"

# --- 基础配置 ---
PROJECT_NAME="ESP Fleet Hub"
VERSION="1.0.0"
DEBUG=True
DATABASE_URL=sqlite:///./app.db

# --- MySQL 数据库配置（Docker compose 部署时使用；本地 SQLite 可不填真实密码） ---
MYSQL_SERVER=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DB=blue_db

# --- Redis 配置（Docker） ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- 安全 / Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 独立凭据加密密钥（留空时回退至从 JWT_SECRET 派生）
WIFI_CRYPTO_KEY=
# 已有管理员后是否允许开放自助注册普通账号；生产锁闭可设为 False
ALLOW_SELF_REGISTER=True
# 固件下载默认要求 Bearer 登录或带签名 ?sig=；兼容旧无签名拉取可设为 True
ALLOW_ANONYMOUS_FIRMWARE_DOWNLOAD=False
# 是否允许未认领旧设备被普通已登录用户直接控制；严格多租户可设为 False
ALLOW_UNCLAIMED_DEVICE_CONTROL=True
# 设备 WS 注册鉴权（HMAC-SHA256 挑战-应答）；空 = 关闭；须与固件 NVS device_secret 一致
DEVICE_SHARED_SECRET=change-me-or-leave-empty
# 是否对 /api/fleet/heartbeat 与 /cmd_ack 强制要求设备 HMAC 签名头（需固件配合）
FLEET_STRICT_DEVICE_AUTH=False

# --- 队列后端：memory | redis ---
QUEUE_BACKEND=memory

# --- 跨域配置 ---
BACKEND_CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:8000"]

# --- 时区 ---
TZ=Asia/Shanghai

# --- 远端固件编译节点（可按需修改或留空使用默认局域网构建节点） ---
IDF_BUILD_CMD=idf-build
IDF_BUILD_SSH_HOST=user@build-host.local
IDF_REMOTE_PROJECT_DIR=/opt/esp/projects/esp_unified_framework
IDF_SSH_KEY=~/.ssh/id_ed25519
# 设备无法访问请求 Host 头时指定可达基准地址（如 http://192.168.1.10:8000）
HUB_PUBLIC_URL=

# --- Home Assistant / MQTT 自动发现桥接（可选；也可在 WebUI 中配置并热加载） ---
HA_MQTT_ENABLED=False
HA_MQTT_HOST=
HA_MQTT_PORT=1883
HA_MQTT_USER=
HA_MQTT_PASS=
HA_DISCOVERY_PREFIX=homeassistant
HA_TOPIC_PREFIX=esp_hub
HA_SYNC_INTERVAL_SEC=10
