# Build context excludes
.git
.gitignore
.vscode
.idea
__pycache__
**/__pycache__
*.pyc
*.pyo

# logs / local data / SQLite DBs
logs/
*.log
*.db
*.db-wal
*.db-shm

# firmware build artifacts (keep source/profiles/tools for unified_bridge)
**/build/
**/managed_components/
**/.pio/
esp_unified_framework/dist/
esp_unified_framework/data/
esp_unified_framework/sdkconfig
esp_unified_framework/sdkconfig.defaults
esp_unified_framework/pipeline.yaml
ble_hid/build/
*.elf
*.map
*.bin

# vue build artifacts (rebuilt in Docker)
vue-project/node_modules
vue-project/dist
vue-project/.vite

# tests / docs not needed at runtime
tests/
docs/

# runtime data (DB backups, uploaded firmware binaries)
backups/
uploads/

# misc local stuff
*.sh
!docker-entrypoint.sh
vehicle_data_backup.sql
vehicle_management.sql
createSql.sql
buckupMysql.sh
install_mysql.sh
uninstall_mysql.sh
insertsql.sh

# env files — pass via compose / -e
.env
.env.*
