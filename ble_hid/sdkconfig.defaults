# ---- target ----
CONFIG_IDF_TARGET="esp32s3"

# ---- partition table & flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- main task ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- SPI RAM (N16R8) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ---- LWIP ----
CONFIG_LWIP_MAX_SOCKETS=10

# ---- WebSocket (managed component will be added) ----
CONFIG_WS_TRANSPORT=y

# ---- NimBLE (BLE HID) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# 配对密钥（bond）持久化到 NVS——不开则 store 只有 RAM 队列，重启即丢，
# 配对过的主机会陷入"重连→加密失败→断开"循环（对 macOS 表现为转圈连不上）
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# ---- TinyUSB (composite HID keyboard + mouse + CDC console) ----
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_HID_BUFSIZE=64
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_PORTS=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_DEBUG_LEVEL=0

# ---- ble_hid app defaults (Kconfig.projbuild) ----
# Default WiFi and server settings
CONFIG_APP_DEFAULT_WIFI_SSID="1"
CONFIG_APP_DEFAULT_WIFI_PASS="11111111"
CONFIG_APP_DEFAULT_SERVER_HOST="192.168.68.159"
CONFIG_APP_DEFAULT_SERVER_PORT=8000
CONFIG_APP_DEFAULT_DEVICE_ID="esp32_001"

# ---- cJSON (built-in) ----
CONFIG_JSON_USE_CJSON=y

# ---- Task WDT ----
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- Logs ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y
