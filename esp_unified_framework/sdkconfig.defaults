CONFIG_IDF_TARGET="esp32"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# Disable brownout detector for WiFi current surge tolerance
CONFIG_ESP_BROWNOUT_DET=n

# Flash Size 4MB & Custom Dual-OTA Partitions
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Enable PSRAM for Camera & High Performance Buffering
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y

# FreeRTOS 1000Hz Tick Rate for Smooth Video Pacing
CONFIG_FREERTOS_HZ=1000

# HTTP Server Configuration
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y

# Default Enabled Features
CONFIG_FEATURE_GPIO_CTRL=y
CONFIG_FEATURE_CAMERA=y
CONFIG_FEATURE_STORAGE=n
CONFIG_FEATURE_DISPLAY=n
CONFIG_FEATURE_USB_OTG=n

CONFIG_APP_DEFAULT_WIFI_SSID="1"
CONFIG_APP_DEFAULT_WIFI_PASS="11111111"
CONFIG_APP_DEFAULT_DEVICE_ID="esp_cam_node"
CONFIG_APP_MDNS_HOST="esp-cam"
